<Window x:Class="Nagara.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nagara.App.Localization"
        Title="{loc:Loc Settings.Title}"
        Width="700"
        Height="850"
        MinWidth="620"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Nagara.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48"
                        Height="48"
                        CornerRadius="11"
                        Background="{StaticResource AccentSoftBrush}"
                        Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/Nagara.ico"
                           Width="34"
                           Height="34"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nagara" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc App.Tagline}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20,24,8">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.DestinationSection}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Loc Settings.DestinationDescription}"
                                   Style="{StaticResource SectionDescription}" />

                        <RadioButton x:Name="SpotifyRadio"
                                     GroupName="Mode"
                                     Content="{loc:Loc Mode.Spotify}"
                                     FontWeight="SemiBold"
                                     Margin="0,16,0,0"
                                     Checked="OnModeChanged" />
                        <TextBlock Text="{loc:Loc Mode.SpotifyDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="22,2,0,0" />

                        <RadioButton x:Name="AutomaticRadio"
                                     GroupName="Mode"
                                     Content="{loc:Loc Mode.Automatic}"
                                     FontWeight="SemiBold"
                                     Margin="0,14,0,0"
                                     Checked="OnModeChanged" />
                        <TextBlock Text="{loc:Loc Mode.AutomaticDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="22,2,0,0" />

                        <RadioButton x:Name="FixedRadio"
                                     GroupName="Mode"
                                     Content="{loc:Loc Mode.Fixed}"
                                     FontWeight="SemiBold"
                                     Margin="0,14,0,0"
                                     Checked="OnModeChanged" />
                        <TextBlock Text="{loc:Loc Mode.FixedDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="22,2,0,0" />

                        <Grid Margin="22,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SessionCombo"
                                      Height="34"
                                      Padding="8,4"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="Label" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Content="{loc:Loc Settings.RefreshSessions}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnRefreshSessions" />
                        </Grid>

                        <TextBlock x:Name="NoSessionsText"
                                   Text="{loc:Loc Settings.NoSessions}"
                                   Style="{StaticResource Hint}"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="22,7,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.BehaviorSection}"
                                   Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="InterceptCheck"
                                  Content="{loc:Loc Settings.Intercept}"
                                  FontWeight="SemiBold"
                                  Margin="0,16,0,0" />
                        <TextBlock Text="{loc:Loc Settings.InterceptDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="22,2,0,0" />

                        <CheckBox x:Name="LaunchAtLoginCheck"
                                  Content="{loc:Loc Settings.LaunchAtLogin}"
                                  FontWeight="SemiBold"
                                  Margin="0,14,0,0" />
                        <TextBlock Text="{loc:Loc Settings.LaunchAtLoginDescription}"
                                   Style="{StaticResource Hint}"
                                   Margin="22,2,0,0" />

                        <TextBlock x:Name="HookWarningText"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.LanguageSection}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Loc Settings.LanguageDescription}"
                                   Style="{StaticResource SectionDescription}" />

                        <ComboBox x:Name="LanguageCombo"
                                  Width="300"
                                  Height="34"
                                  Padding="8,4"
                                  HorizontalAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label"
                                  Margin="0,12,0,0" />

                        <Border Background="{StaticResource HintBackgroundBrush}"
                                BorderBrush="{StaticResource HintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,12,0,0">
                            <TextBlock Text="{loc:Loc Settings.LanguageRestartNote}"
                                       Foreground="{StaticResource HintTextBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.DiagnosticsSection}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Loc Settings.DiagnosticsDescription}"
                                   Style="{StaticResource SectionDescription}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{loc:Loc Settings.HookStatus}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="HookStatusValue" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="{loc:Loc Settings.LastKey}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="LastKeyValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Text="{loc:Loc Settings.LastTarget}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="LastTargetValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Text="{loc:Loc Settings.Version}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="VersionValue" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Text="{loc:Loc Settings.ExecutablePath}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="ExecutablePathValue" Grid.Row="4" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="5" Text="{loc:Loc Settings.SettingsPath}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock x:Name="SettingsPathValue" Grid.Row="5" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="6" Text="{loc:Loc Diagnostics.LastError}" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="LastErrorValue" Grid.Row="6" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="{loc:Loc Settings.Sessions}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,6" />
                        <TextBlock x:Name="DiagnosticsSessionsEmpty"
                                   Text="{loc:Loc Settings.NoActiveSessions}"
                                   Style="{StaticResource Hint}"
                                   Margin="2,0,0,6"
                                   Visibility="Collapsed" />
                        <Border BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#FAFCFB"
                                Padding="6">
                            <ListBox x:Name="SessionsList"
                                     Height="132"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AppUserModelId}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock x:Name="DiagnosticsErrorText"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Loc Settings.CopyDiagnostics}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OnCopyDiagnostics" />
                            <Button Content="{loc:Loc Settings.OpenLogFolder}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnOpenLogFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc App.PrivacyNote}"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="4,0,4,6" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc Settings.Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="OnCancel" />
                    <Button Content="{loc:Loc Settings.Save}"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
