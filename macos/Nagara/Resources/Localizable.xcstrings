          }
        }
      }
    },
    "permission.automation.checkNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The check launches Music for verification, but does not start playback."
