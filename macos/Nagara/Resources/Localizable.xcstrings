    "permission.accessibility.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings → Privacy & Security → Accessibility, add Nagara, and turn it on. Nagara detects the change when you return to the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 → プライバシーとセキュリティ → アクセシビリティ で Nagara を追加し、オンにしてください。Nagara に戻ると変更を検出します。"
          }
        }
      }
    },
    "permission.accessibility.heading" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティ"
          }
        }
      }
    },
    "permission.automation.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS shows a confirmation dialog the first time Nagara controls a player. If it was declined, open System Settings → Privacy & Security → Automation and enable Nagara for the player you want to control."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagara が初めてプレイヤーを操作するときに、macOS の確認ダイアログが表示されます。拒否した場合は、システム設定 → プライバシーとセキュリティ → オートメーション で、操作したいプレイヤーに対する Nagara をオンにしてください。"
          }
        }
      }
    },
    "permission.automation.checkMusic" : {
      "extractionState" : "manual",
